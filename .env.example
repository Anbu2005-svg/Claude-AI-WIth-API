# No API keys are stored on the server.
# The user enters their own API key in the browser UI and it is saved
# only to the browser's localStorage (browser cache). It is never
# written to .env or any server-side file.

PORT=3001

# Comma-separated list of frontend origins allowed to call this backend.
# Never use * in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
