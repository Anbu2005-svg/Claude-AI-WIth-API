{
  "name": "claude-style-chat-backend",
  "version": "1.0.0",
  "description": "Minimal Express backend that proxies chat requests. The API key is supplied by the client (browser) and never stored on the server.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "prisma": "^7.9.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
